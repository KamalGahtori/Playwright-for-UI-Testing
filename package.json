{
  "name": "playwright-ui-testing",
  "version": "1.0.0",
  "description": "Visual regression and interaction audit framework for ksolves.com",
  "scripts": {
    "visual": "npx playwright test tests/visual/",
    "baseline": "npx playwright test tests/visual/ --update-snapshots=all",
    "interaction": "npx playwright test tests/interaction/ --config playwright.interaction.config.js",
    "report:visual": "npx playwright show-report",
    "report:interaction": "npx playwright show-report interaction-report"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "dotenv": "^17.4.1"
  },
  "dependencies": {
    "crawlee": "^3.16.0"
  }
}