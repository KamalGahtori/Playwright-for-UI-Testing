{
  "name": "playwright_for_ui_testing",
  "version": "1.0.0",
  "description": "Data-Driven Visual Regression Testing Framework",
  "main": "index.js",
  "scripts": {
    "visual": "node scripts/run-tests.js visual",
    "interaction": "node scripts/run-tests.js interaction",
    "interaction:ui": "node scripts/run-tests.js ui",
    "baseline": "node scripts/run-tests.js baseline",
    "full": "node scripts/run-tests.js full",
    "report": "npx playwright show-report",
    "report:interaction": "npx playwright show-report interaction-report",
    "test:ui": "npx playwright test tests/visual/ --ui",
    "test:headed": "npx playwright test tests/visual/ --headed",
    "test:debug": "npx playwright test tests/visual/ --debug"
  },
